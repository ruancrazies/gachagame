{
  "name": "gacha-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Game gacha th\u1ea7n tho\u1ea1i: \u0111\u1ea5u t\u1ef1 \u0111\u1ed9ng theo l\u01b0\u1ee3t, server gi\u1eef to\u00e0n b\u1ed9 logic.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:config": "tsx scripts/validate-config.ts",
    "build:web": "npm run build -w @gacha/web",
    "dev:server": "npm run dev -w @gacha/server",
    "dev:web": "npm run dev -w @gacha/web",
    "check": "npm run lint && npm run typecheck && npm run test && npm run validate:config && npm run build:web",
    "simulate": "tsx scripts/simulate-batch.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
